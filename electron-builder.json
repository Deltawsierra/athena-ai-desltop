{
  "appId": "com.athenaai.desktop",
  "productName": "Athena AI",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron-main.cjs",
    "electron-preload.cjs",
    "!dist/**/*.map"
  ],
  "extraResources": [
    {
      "from": "attached_assets/generated_images",
      "to": "attached_assets/generated_images",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.icns",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "dmg": {
    "artifactName": "AthenaAI-${version}-${arch}.${ext}",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 400
    },
    "title": "Athena AI ${version}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "AthenaAI-Setup-${version}.${ext}",
    "verifyUpdateCodeSignature": false,
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "artifactName": "AthenaAI-Setup-${version}.${ext}",
    "menuCategory": "Athena AI",
    "shortcutName": "Athena AI"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Development",
    "artifactName": "AthenaAI-${version}-${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "Athena AI",
        "Comment": "Cybersecurity Intelligence Platform",
        "Categories": "Development;Security;",
        "Keywords": "security;cybersecurity;pentest;cve;ai;"
      }
    }
  },
  "appImage": {
    "artifactName": "AthenaAI-${version}.${ext}"
  },
  "publish": null
}
